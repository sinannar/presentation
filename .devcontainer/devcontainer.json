{
  "name": "Presentation template",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "postCreateCommand": "npm ci",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro preview",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode"]
    }
  }
}
