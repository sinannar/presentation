{
  "name": "presentation-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "init:presentation": "tsx scripts/initialize.ts",
    "validate": "tsx scripts/validate-content.ts",
    "validate:sources": "tsx scripts/index-sources.ts",
    "validate:research": "tsx scripts/validate-research.ts",
    "validate:news-run": "tsx scripts/validate-news-run.ts",
    "validate:agents": "tsx scripts/validate-agent-assets.ts",
    "check": "npm run validate && npm run validate:agents && astro check",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:production": "node --import tsx --test tests/build/*.test.ts"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "mqtt": "^5.16.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "happy-dom": "^21.0.4",
    "js-yaml": "^5.5.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
  }
}
