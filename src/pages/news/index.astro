---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedNews, displayDate } from '../../lib/content';
import { withBase } from '../../lib/urls';
const news = await publishedNews();
---
<BaseLayout title="News"><p class="eyebrow">News</p><h1>What changed.</h1><div class="grid">{news.map((item) => <a class="card" href={withBase(`/news/${item.id}/`)}><p class="meta">{displayDate(item.data.published)} · {item.data.category}</p><h2>{item.data.title}</h2><p>{item.data.summary}</p></a>)}</div></BaseLayout>
