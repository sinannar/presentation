---
import { siteConfig } from '../../site.config';
import { getCollection } from 'astro:content';
import { displayDate } from '../lib/content';
import { selectDeck, type DeckReference } from '../lib/deck';
import AttributedImage from '../components/AttributedImage.astro';
import { withBase } from '../lib/urls';
import '../styles/global.css';
import '../styles/keynote.css';

const docs = (await getCollection('docs'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const news = (await getCollection('news'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const contentScenes = selectDeck([
  ...docs.map((doc) => ({
    id: `docs-${doc.id}`,
    reference: `docs/${doc.id}` as DeckReference,
    draft: doc.data.draft,
    kind: 'content',
    section: doc.data.category,
    type: 'Guide',
    title: doc.data.title,
    category: doc.data.category,
    summary: doc.data.summary,
    detail: doc.data.takeaway,
    href: withBase(`/docs/${doc.id}/`),
    link: 'Read the guide',
    meta: '',
    featured: doc.data.featured,
    notes: doc.data.speakerNotes,
    reveals: doc.data.reveals,
    image: doc.data.image,
    source: 'Docs',
  })),
  ...news.map((item) => ({
    id: `news-${item.id}`,
    reference: `news/${item.id}` as DeckReference,
    draft: item.data.draft,
    kind: 'content',
    section: item.data.category,
    type: 'News',
    title: item.data.title,
    category: item.data.category,
    summary: item.data.summary,
    detail: item.data.status,
    href: withBase(`/news/${item.id}/`),
    link: 'Read the update',
    meta: displayDate(item.data.published),
    featured: item.data.featured,
    notes: item.data.speakerNotes,
    reveals: item.data.reveals,
    image: item.data.image,
    source: 'News',
  })),
], siteConfig.presentation);
const sections = [...new Set(contentScenes.map((scene) => scene.section))]
  .map((name) => ({
    name,
    scenes: contentScenes.filter((scene) => scene.section === name),
  }));
const highlights = contentScenes.filter((scene) => scene.featured);
const emptyNotes = { talkingPoints: [], technicalDetails: [], transition: '' };
const notesFor = (notes?: { talkingPoints?: string[]; technicalDetails?: string[]; transition?: string }) => ({
  talkingPoints: notes?.talkingPoints ?? [],
  technicalDetails: notes?.technicalDetails ?? [],
  transition: notes?.transition ?? '',
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={siteConfig.description} />
    <title>{siteConfig.title}</title>
  </head>
  <body class="keynote">
    <a class="skip-link" href="#keynote-stage">Skip to presentation</a>
    <div class="keynote-shell">
      <main id="keynote-stage" class="keynote-stage" aria-label="Presentation" tabindex="-1">
        <section
          class="scene scene-opening"
          data-scene="home"
          data-section=""
          data-kind="home"
          data-summary={siteConfig.tagline}
          data-featured="false"
          data-notes={JSON.stringify(emptyNotes)}
          aria-label="Opening"
        >
          <div class="scene-inner">
            <p class="scene-kicker">A presentation by {siteConfig.author}</p>
            <h1 class="opening-title">{siteConfig.title}</h1>
            <p class="opening-subtitle">{siteConfig.tagline}</p>
            <p class="opening-presenter" data-presenter-details></p>
            <div class="opening-actions">
              <button class="action action-primary" type="button" data-start>
                Start presentation <span aria-hidden="true">→</span>
              </button>
              <button class="action action-secondary" type="button" data-jump-scene="highlights">
                Highlights <span aria-hidden="true">✦</span>
              </button>
              <button class="action action-secondary" type="button" data-jump-scene="sections">
                Sections <span aria-hidden="true">☷</span>
              </button>
              <a class="action action-secondary" href={siteConfig.primaryLink.href}>
                {siteConfig.primaryLink.label} <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="opening-links">
              <a href={withBase('/docs/')}>Read the docs</a>
              <a href={withBase('/news/')}>See the news</a>
            </div>
            <p class="opening-hint"><kbd>→</kbd> Next <span aria-hidden="true">·</span> <kbd>?</kbd> Help</p>
          </div>
        </section>

        <section
          class="scene scene-overview scene-sections"
          data-scene="sections"
          data-section=""
          data-kind="sections"
          data-summary="Browse the published presentation by its content categories."
          data-featured="false"
          data-notes={JSON.stringify(emptyNotes)}
          aria-labelledby="sections-title"
        >
          <div class="scene-inner overview-inner">
            <div class="overview-heading">
              <div>
                <p class="scene-kicker">A map of the story <span aria-hidden="true">·</span> {sections.length} {sections.length === 1 ? 'section' : 'sections'}</p>
                <h2 id="sections-title">Choose a section.</h2>
                <p class="scene-summary">Jump into any published category, or move through the presentation in order.</p>
              </div>
              <span class="overview-mark overview-mark-sections" aria-hidden="true">01</span>
            </div>
            {sections.length > 0 ? (
              <div class="overview-grid section-grid">
                {sections.map((section, index) => {
                  const firstScene = section.scenes[0];
                  const summaries = section.scenes.slice(0, 2).map((scene) => scene.title);
                  return (
                    <button
                      class="overview-card section-card"
                      type="button"
                      data-jump-scene={firstScene.id}
                      aria-label={`Jump to ${section.name}`}
                    >
                      <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
                      <span class="card-type">{section.scenes.length} {section.scenes.length === 1 ? 'story' : 'stories'}</span>
                      <span class="card-title">{section.name}</span>
                      <span class="card-description">{summaries.join(' · ')}{section.scenes.length > 2 ? ` · +${section.scenes.length - 2} more` : ''}</span>
                      <span class="card-arrow" aria-hidden="true">↗</span>
                    </button>
                  );
                })}
              </div>
            ) : (
              <p class="overview-empty">Published stories will appear here when content is added.</p>
            )}
          </div>
        </section>

        <section
          class="scene scene-overview scene-highlights"
          data-scene="highlights"
          data-section=""
          data-kind="highlights"
          data-summary="Explore published stories marked as featured."
          data-featured="false"
          data-notes={JSON.stringify(emptyNotes)}
          aria-labelledby="highlights-title"
        >
          <div class="scene-inner overview-inner">
            <div class="overview-heading">
              <div>
                <p class="scene-kicker">Selected from the published content <span aria-hidden="true">·</span> {highlights.length} {highlights.length === 1 ? 'highlight' : 'highlights'}</p>
                <h2 id="highlights-title">Worth a closer look.</h2>
                <p class="scene-summary">A visual shortlist assembled from the content marked as featured.</p>
              </div>
              <span class="overview-mark overview-mark-highlights" aria-hidden="true">✳</span>
            </div>
            {highlights.length > 0 ? (
              <div class="overview-grid highlight-grid">
                {highlights.map((scene, index) => (
                  <button
                    class="overview-card highlight-card"
                    type="button"
                    data-jump-scene={scene.id}
                    aria-label={`Jump to featured ${scene.source.toLowerCase()}: ${scene.title}`}
                  >
                    <span class="highlight-topline"><span>{scene.source}</span><span>{String(index + 1).padStart(2, '0')}</span></span>
                    <span class="card-title">{scene.title}</span>
                    <span class="card-description">{scene.summary}</span>
                    <span class="highlight-footer"><span>{scene.category}</span><span class="card-arrow" aria-hidden="true">↗</span></span>
                  </button>
                ))}
              </div>
            ) : (
              <div class="overview-empty highlight-empty">
                <span class="empty-star" aria-hidden="true">✳</span>
                <p>No published stories are featured yet.</p>
                <span>Mark a published doc or news item as featured to surface it here.</span>
              </div>
            )}
          </div>
        </section>

        {contentScenes.map((scene) => (
          <section
            class:list={['scene', 'scene-content', scene.source === 'Docs' ? 'scene-doc' : 'scene-news']}
            data-scene={scene.id}
            data-section={scene.section}
            data-kind={scene.kind}
            data-summary={scene.summary}
            data-featured={String(scene.featured)}
            data-notes={JSON.stringify(notesFor(scene.notes))}
            aria-label={scene.title}
          >
            <div class="scene-inner">
              <div class="scene-copy">
                <p class="scene-kicker">{scene.type} <span aria-hidden="true">·</span> {scene.category}{scene.meta && ` · ${scene.meta}`}</p>
                <h2>{scene.title}</h2>
                <p class="scene-summary">{scene.summary}</p>
                {scene.reveals.length > 0 && (
                  <ul class="scene-reveals" aria-label="Key points">
                    {scene.reveals.map((reveal) => <li data-reveal>{reveal}</li>)}
                  </ul>
                )}
                {scene.detail && <div class="scene-detail"><span>{scene.source === 'Docs' ? 'Keep in mind' : 'Status'}</span><p>{scene.detail}</p></div>}
                <a class="text-link" href={scene.href}>{scene.link} <span aria-hidden="true">↗</span></a>
              </div>
              {scene.image ? <AttributedImage image={scene.image} /> : (
                <div class:list={['content-visual', scene.source === 'Docs' ? 'content-visual-doc' : 'content-visual-news']} aria-hidden="true">
                  <span class="visual-orbit orbit-one"></span>
                  <span class="visual-orbit orbit-two"></span>
                  <span class="visual-glyph">{scene.source === 'Docs' ? '↗' : '✳'}</span>
                  <span class="visual-label">{scene.category}</span>
                </div>
              )}
            </div>
          </section>
        ))}
      </main>
      <nav class="keynote-controls" aria-label="Presentation controls" hidden>
        <div class="control-breadcrumb">
          <button type="button" class="control-home" data-home><span aria-hidden="true">⌂</span> <span>Home</span></button>
          <span class="control-separator" aria-hidden="true">/</span>
          <span class="current-scene"><span class="current-dot" aria-hidden="true"></span><span data-scene-name aria-live="polite">{siteConfig.title}</span></span>
          <span class="scene-count"><span class="control-count-label">Scene / step</span> <span data-count></span></span>
        </div>
        <div class="control-actions">
          <button type="button" data-map aria-label="Open presentation map"><span aria-hidden="true">▦</span> <span>Map</span></button>
          <span class="control-divider" aria-hidden="true"></span>
          <button type="button" data-prev><span aria-hidden="true">←</span> <span>Back</span></button>
          <button type="button" class="control-next" data-next>Next <span aria-hidden="true">→</span></button>
          <button type="button" data-help aria-label="Keyboard help"><span aria-hidden="true">?</span> <span>Help</span></button>
        </div>
        <span data-keynote-status role="status"></span>
      </nav>
    </div>
    <dialog class="help-dialog" aria-labelledby="help-title" aria-describedby="help-description">
      <div class="help-heading">
        <div><h2 id="help-title">Getting around</h2><p id="help-description">Move through the presentation at your own pace.</p></div>
        <button class="help-close" type="button" data-close-help aria-label="Close help">×</button>
      </div>
      <div class="help-intro"><strong>Move through the story</strong><p>Reveal steps, jump between screens, or open presenter tools when you need them.</p></div>
      <div class="help-columns">
        <section>
          <h3>Navigate</h3>
          <div class="help-row"><span><kbd>→</kbd> <kbd>←</kbd> <kbd>Space</kbd></span><p>Reveal steps; clicker Page Up/Down also works</p></div>
          <div class="help-row"><span><kbd>Shift</kbd> + <kbd>←</kbd>/<kbd>→</kbd></span><p>Skip a screen</p></div>
          <div class="help-row"><span><kbd>Home</kbd></span><p>Return to the beginning</p></div>
          <div class="help-row"><span><kbd>M</kbd> / <kbd>G</kbd></span><p>Open the map</p></div>
          <div class="help-row"><span><kbd>1</kbd>–<kbd>9</kbd></span><p>Jump to one of the first nine sections</p></div>
        </section>
        <section>
          <h3>Presenter tools</h3>
          <div class="help-row"><span><kbd>T</kbd></span><p>Open highlights</p></div>
          <div class="help-row"><span><kbd>P</kbd></span><p>Open the presenter window</p></div>
          <div class="help-row"><span><kbd>N</kbd></span><p>Show or hide notes</p></div>
          <div class="help-row"><span><kbd>E</kbd></span><p>Edit presenter details</p></div>
          <div class="help-row"><span><kbd>R</kbd></span><p>Open remote pairing</p></div>
        </section>
        <section>
          <h3>View</h3>
          <div class="help-row"><span><kbd>H</kbd></span><p>Hide or show controls</p></div>
          <div class="help-row"><span><kbd>B</kbd></span><p>Toggle the black screen</p></div>
          <div class="help-row"><span><kbd>S</kbd></span><p>Reveal all current steps</p></div>
          <div class="help-row"><span><kbd>F</kbd></span><p>Enter or exit fullscreen</p></div>
          <div class="help-row"><span><kbd>Esc</kbd></span><p>Close dialogs or exit fullscreen</p></div>
          <div class="help-row"><span><kbd>?</kbd></span><p>Open this help</p></div>
        </section>
      </div>
    </dialog>
    <script src="../scripts/keynote.ts"></script>
  </body>
</html>
